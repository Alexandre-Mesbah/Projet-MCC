; General unary multiplication machine.
; Input: 1^n#1^m.
; Behavior: leave exactly 1^(n*m) on tape 1 and halt.
; This machine uses 3 tapes and the working alphabet {1,#,|,_}.
name: unary_multiply
init: I
final: F
blank: _
tapes: 3
COPY_M 1,_,# -> COPY_M 1,1,# R,R,S
COPY_M 1,_,0 -> COPY_M 1,1,0 R,R,S
COPY_M 1,_,1 -> COPY_M 1,1,1 R,R,S
COPY_M 1,_,_ -> COPY_M 1,1,_ R,R,S
COPY_M 1,_,| -> COPY_M 1,1,| R,R,S
