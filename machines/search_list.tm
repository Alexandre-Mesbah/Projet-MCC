; General list membership machine.
; Input: x#w1#w2#...#wl with x and all wi in {0,1}*.
; Behavior: halt iff x = wi for some i, loop forever otherwise.
name: search_list
init: I
final: F
blank: _
tapes: 2
COMPARE #,0 -> REWIND_AFTER_FAIL_PRE #,0 R,L
COMPARE #,1 -> REWIND_AFTER_FAIL_PRE #,1 R,L
COMPARE #,_ -> F #,_ S,S
COMPARE 0,0 -> COMPARE 0,0 R,R
COMPARE 0,1 -> SKIP_CANDIDATE 0,1 S,S
COMPARE 0,_ -> SKIP_CANDIDATE 0,_ S,S
COMPARE 1,0 -> SKIP_CANDIDATE 1,0 S,S
COMPARE 1,1 -> COMPARE 1,1 R,R
COMPARE 1,_ -> SKIP_CANDIDATE 1,_ S,S
COMPARE _,0 -> LOOP _,0 S,S
COMPARE _,1 -> LOOP _,1 S,S
COMPARE _,_ -> F _,_ S,S
COMPARE_EMPTY_X #,# -> F #,# S,S
COMPARE_EMPTY_X #,0 -> F #,0 S,S
COMPARE_EMPTY_X #,1 -> F #,1 S,S
COMPARE_EMPTY_X #,_ -> F #,_ S,S
COMPARE_EMPTY_X #,| -> F #,| S,S
COMPARE_EMPTY_X 0,# -> SKIP_EMPTY_X 0,# S,S
COMPARE_EMPTY_X 0,0 -> SKIP_EMPTY_X 0,0 S,S
COMPARE_EMPTY_X 0,1 -> SKIP_EMPTY_X 0,1 S,S
COMPARE_EMPTY_X 0,_ -> SKIP_EMPTY_X 0,_ S,S
COMPARE_EMPTY_X 0,| -> SKIP_EMPTY_X 0,| S,S
COMPARE_EMPTY_X 1,# -> SKIP_EMPTY_X 1,# S,S
COMPARE_EMPTY_X 1,0 -> SKIP_EMPTY_X 1,0 S,S
COMPARE_EMPTY_X 1,1 -> SKIP_EMPTY_X 1,1 S,S
COMPARE_EMPTY_X 1,_ -> SKIP_EMPTY_X 1,_ S,S
COMPARE_EMPTY_X 1,| -> SKIP_EMPTY_X 1,| S,S
COMPARE_EMPTY_X _,# -> F _,# S,S
COMPARE_EMPTY_X _,0 -> F _,0 S,S
COMPARE_EMPTY_X _,1 -> F _,1 S,S
COMPARE_EMPTY_X _,_ -> F _,_ S,S
COMPARE_EMPTY_X _,| -> F _,| S,S
COPY_X #,_ -> REWIND_X_PRE #,_ R,L
COPY_X 0,_ -> COPY_X 0,0 R,R
COPY_X 1,_ -> COPY_X 1,1 R,R
I #,_ -> COMPARE_EMPTY_X #,_ R,S
I 0,_ -> COPY_X 0,0 R,R
I 1,_ -> COPY_X 1,1 R,R
LOOP #,# -> LOOP #,# S,S
LOOP #,0 -> LOOP #,0 S,S
LOOP #,1 -> LOOP #,1 S,S
LOOP #,_ -> LOOP #,_ S,S
LOOP #,| -> LOOP #,| S,S
LOOP 0,# -> LOOP 0,# S,S
LOOP 0,0 -> LOOP 0,0 S,S
LOOP 0,1 -> LOOP 0,1 S,S
LOOP 0,_ -> LOOP 0,_ S,S
LOOP 0,| -> LOOP 0,| S,S
LOOP 1,# -> LOOP 1,# S,S
LOOP 1,0 -> LOOP 1,0 S,S
LOOP 1,1 -> LOOP 1,1 S,S
LOOP 1,_ -> LOOP 1,_ S,S
LOOP 1,| -> LOOP 1,| S,S
LOOP _,# -> LOOP _,# S,S
LOOP _,0 -> LOOP _,0 S,S
LOOP _,1 -> LOOP _,1 S,S
LOOP _,_ -> LOOP _,_ S,S
LOOP _,| -> LOOP _,| S,S
LOOP |,# -> LOOP |,# S,S
LOOP |,0 -> LOOP |,0 S,S
LOOP |,1 -> LOOP |,1 S,S
LOOP |,_ -> LOOP |,_ S,S
LOOP |,| -> LOOP |,| S,S
REWIND_AFTER_FAIL #,0 -> REWIND_AFTER_FAIL #,0 S,L
REWIND_AFTER_FAIL #,1 -> REWIND_AFTER_FAIL #,1 S,L
REWIND_AFTER_FAIL #,_ -> COMPARE #,_ S,R
REWIND_AFTER_FAIL 0,0 -> REWIND_AFTER_FAIL 0,0 S,L
REWIND_AFTER_FAIL 0,1 -> REWIND_AFTER_FAIL 0,1 S,L
REWIND_AFTER_FAIL 0,_ -> COMPARE 0,_ S,R
REWIND_AFTER_FAIL 1,0 -> REWIND_AFTER_FAIL 1,0 S,L
REWIND_AFTER_FAIL 1,1 -> REWIND_AFTER_FAIL 1,1 S,L
REWIND_AFTER_FAIL 1,_ -> COMPARE 1,_ S,R
REWIND_AFTER_FAIL _,0 -> REWIND_AFTER_FAIL _,0 S,L
REWIND_AFTER_FAIL _,1 -> REWIND_AFTER_FAIL _,1 S,L
REWIND_AFTER_FAIL _,_ -> COMPARE _,_ S,R
REWIND_AFTER_FAIL |,0 -> REWIND_AFTER_FAIL |,0 S,L
REWIND_AFTER_FAIL |,1 -> REWIND_AFTER_FAIL |,1 S,L
REWIND_AFTER_FAIL |,_ -> COMPARE |,_ S,R
REWIND_AFTER_FAIL_PRE #,# -> REWIND_AFTER_FAIL #,# S,S
REWIND_AFTER_FAIL_PRE #,0 -> REWIND_AFTER_FAIL #,0 S,S
REWIND_AFTER_FAIL_PRE #,1 -> REWIND_AFTER_FAIL #,1 S,S
REWIND_AFTER_FAIL_PRE #,_ -> REWIND_AFTER_FAIL #,_ S,S
REWIND_AFTER_FAIL_PRE #,| -> REWIND_AFTER_FAIL #,| S,S
REWIND_AFTER_FAIL_PRE 0,# -> REWIND_AFTER_FAIL 0,# S,S
REWIND_AFTER_FAIL_PRE 0,0 -> REWIND_AFTER_FAIL 0,0 S,S
REWIND_AFTER_FAIL_PRE 0,1 -> REWIND_AFTER_FAIL 0,1 S,S
REWIND_AFTER_FAIL_PRE 0,_ -> REWIND_AFTER_FAIL 0,_ S,S
REWIND_AFTER_FAIL_PRE 0,| -> REWIND_AFTER_FAIL 0,| S,S
REWIND_AFTER_FAIL_PRE 1,# -> REWIND_AFTER_FAIL 1,# S,S
REWIND_AFTER_FAIL_PRE 1,0 -> REWIND_AFTER_FAIL 1,0 S,S
REWIND_AFTER_FAIL_PRE 1,1 -> REWIND_AFTER_FAIL 1,1 S,S
REWIND_AFTER_FAIL_PRE 1,_ -> REWIND_AFTER_FAIL 1,_ S,S
REWIND_AFTER_FAIL_PRE 1,| -> REWIND_AFTER_FAIL 1,| S,S
REWIND_AFTER_FAIL_PRE _,# -> REWIND_AFTER_FAIL _,# S,S
REWIND_AFTER_FAIL_PRE _,0 -> REWIND_AFTER_FAIL _,0 S,S
REWIND_AFTER_FAIL_PRE _,1 -> REWIND_AFTER_FAIL _,1 S,S
REWIND_AFTER_FAIL_PRE _,_ -> REWIND_AFTER_FAIL _,_ S,S
REWIND_AFTER_FAIL_PRE _,| -> REWIND_AFTER_FAIL _,| S,S
REWIND_AFTER_FAIL_PRE |,# -> REWIND_AFTER_FAIL |,# S,S
REWIND_AFTER_FAIL_PRE |,0 -> REWIND_AFTER_FAIL |,0 S,S
REWIND_AFTER_FAIL_PRE |,1 -> REWIND_AFTER_FAIL |,1 S,S
REWIND_AFTER_FAIL_PRE |,_ -> REWIND_AFTER_FAIL |,_ S,S
REWIND_AFTER_FAIL_PRE |,| -> REWIND_AFTER_FAIL |,| S,S
REWIND_X #,0 -> REWIND_X #,0 S,L
REWIND_X #,1 -> REWIND_X #,1 S,L
REWIND_X #,_ -> COMPARE #,_ S,R
REWIND_X 0,0 -> REWIND_X 0,0 S,L
REWIND_X 0,1 -> REWIND_X 0,1 S,L
REWIND_X 0,_ -> COMPARE 0,_ S,R
REWIND_X 1,0 -> REWIND_X 1,0 S,L
REWIND_X 1,1 -> REWIND_X 1,1 S,L
REWIND_X 1,_ -> COMPARE 1,_ S,R
REWIND_X _,0 -> REWIND_X _,0 S,L
REWIND_X _,1 -> REWIND_X _,1 S,L
REWIND_X _,_ -> COMPARE _,_ S,R
REWIND_X |,0 -> REWIND_X |,0 S,L
REWIND_X |,1 -> REWIND_X |,1 S,L
REWIND_X |,_ -> COMPARE |,_ S,R
REWIND_X_PRE #,# -> REWIND_X #,# S,S
REWIND_X_PRE #,0 -> REWIND_X #,0 S,S
REWIND_X_PRE #,1 -> REWIND_X #,1 S,S
REWIND_X_PRE #,_ -> REWIND_X #,_ S,S
REWIND_X_PRE #,| -> REWIND_X #,| S,S
REWIND_X_PRE 0,# -> REWIND_X 0,# S,S
REWIND_X_PRE 0,0 -> REWIND_X 0,0 S,S
REWIND_X_PRE 0,1 -> REWIND_X 0,1 S,S
REWIND_X_PRE 0,_ -> REWIND_X 0,_ S,S
REWIND_X_PRE 0,| -> REWIND_X 0,| S,S
REWIND_X_PRE 1,# -> REWIND_X 1,# S,S
REWIND_X_PRE 1,0 -> REWIND_X 1,0 S,S
REWIND_X_PRE 1,1 -> REWIND_X 1,1 S,S
REWIND_X_PRE 1,_ -> REWIND_X 1,_ S,S
REWIND_X_PRE 1,| -> REWIND_X 1,| S,S
REWIND_X_PRE _,# -> REWIND_X _,# S,S
REWIND_X_PRE _,0 -> REWIND_X _,0 S,S
REWIND_X_PRE _,1 -> REWIND_X _,1 S,S
REWIND_X_PRE _,_ -> REWIND_X _,_ S,S
REWIND_X_PRE _,| -> REWIND_X _,| S,S
REWIND_X_PRE |,# -> REWIND_X |,# S,S
REWIND_X_PRE |,0 -> REWIND_X |,0 S,S
REWIND_X_PRE |,1 -> REWIND_X |,1 S,S
REWIND_X_PRE |,_ -> REWIND_X |,_ S,S
REWIND_X_PRE |,| -> REWIND_X |,| S,S
SKIP_CANDIDATE #,# -> REWIND_AFTER_FAIL_PRE #,# R,L
SKIP_CANDIDATE #,0 -> REWIND_AFTER_FAIL_PRE #,0 R,L
SKIP_CANDIDATE #,1 -> REWIND_AFTER_FAIL_PRE #,1 R,L
SKIP_CANDIDATE #,_ -> REWIND_AFTER_FAIL_PRE #,_ R,L
SKIP_CANDIDATE #,| -> REWIND_AFTER_FAIL_PRE #,| R,L
SKIP_CANDIDATE 0,# -> SKIP_CANDIDATE 0,# R,S
SKIP_CANDIDATE 0,0 -> SKIP_CANDIDATE 0,0 R,S
SKIP_CANDIDATE 0,1 -> SKIP_CANDIDATE 0,1 R,S
SKIP_CANDIDATE 0,_ -> SKIP_CANDIDATE 0,_ R,S
SKIP_CANDIDATE 0,| -> SKIP_CANDIDATE 0,| R,S
SKIP_CANDIDATE 1,# -> SKIP_CANDIDATE 1,# R,S
SKIP_CANDIDATE 1,0 -> SKIP_CANDIDATE 1,0 R,S
SKIP_CANDIDATE 1,1 -> SKIP_CANDIDATE 1,1 R,S
SKIP_CANDIDATE 1,_ -> SKIP_CANDIDATE 1,_ R,S
SKIP_CANDIDATE 1,| -> SKIP_CANDIDATE 1,| R,S
SKIP_CANDIDATE _,# -> LOOP _,# S,S
SKIP_CANDIDATE _,0 -> LOOP _,0 S,S
SKIP_CANDIDATE _,1 -> LOOP _,1 S,S
SKIP_CANDIDATE _,_ -> LOOP _,_ S,S
SKIP_CANDIDATE _,| -> LOOP _,| S,S
SKIP_EMPTY_X #,# -> COMPARE_EMPTY_X #,# R,S
SKIP_EMPTY_X #,0 -> COMPARE_EMPTY_X #,0 R,S
SKIP_EMPTY_X #,1 -> COMPARE_EMPTY_X #,1 R,S
SKIP_EMPTY_X #,_ -> COMPARE_EMPTY_X #,_ R,S
SKIP_EMPTY_X #,| -> COMPARE_EMPTY_X #,| R,S
SKIP_EMPTY_X 0,# -> SKIP_EMPTY_X 0,# R,S
SKIP_EMPTY_X 0,0 -> SKIP_EMPTY_X 0,0 R,S
SKIP_EMPTY_X 0,1 -> SKIP_EMPTY_X 0,1 R,S
SKIP_EMPTY_X 0,_ -> SKIP_EMPTY_X 0,_ R,S
SKIP_EMPTY_X 0,| -> SKIP_EMPTY_X 0,| R,S
SKIP_EMPTY_X 1,# -> SKIP_EMPTY_X 1,# R,S
SKIP_EMPTY_X 1,0 -> SKIP_EMPTY_X 1,0 R,S
SKIP_EMPTY_X 1,1 -> SKIP_EMPTY_X 1,1 R,S
SKIP_EMPTY_X 1,_ -> SKIP_EMPTY_X 1,_ R,S
SKIP_EMPTY_X 1,| -> SKIP_EMPTY_X 1,| R,S
SKIP_EMPTY_X _,# -> LOOP _,# S,S
SKIP_EMPTY_X _,0 -> LOOP _,0 S,S
SKIP_EMPTY_X _,1 -> LOOP _,1 S,S
SKIP_EMPTY_X _,_ -> LOOP _,_ S,S
